# Editor settings for the project's own files (https://editorconfig.org)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,json}]
indent_style = tab
indent_size = 4
max_line_length = 140

[*.{md,yml,yaml,toml}]
indent_style = space
indent_size = 2

# Never edited (see test_batch_files_never_change in server/tests/test_update.py)
[*.bat]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
